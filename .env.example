# ─────────────────────────────────────────────────────────────
# Template. Copy to .env and fill in. Do NOT put real secrets here.
# On HF Space, set the SECRETS below via Space → Settings → Secrets.
# ─────────────────────────────────────────────────────────────

# ── Secrets (server-side only — NEVER expose to the browser) ──
# Supabase project REST URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Supabase service_role key (server-side only)
SUPABASE_SERVICE_KEY=
# Salt for hashing client IPs (rate-limit/abuse only; raw IPs are never stored).
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
IP_HASH_SALT=
# NDIF API key — REQUIRED. Powers both live scoring and offline extraction.
# Must stay server-side; if it leaks, anyone can drain your NDIF quota.
# Get a key from https://login.ndif.us
NDIF_API_KEY=
# Optional HF token, only if NNsight needs it to resolve gated model configs.
HF_TOKEN=

# ── Model / scoring config (overrides app/config.py defaults) ──
# Confirm the exact NDIF-hosted model id/string before pinning.
MODEL_ID=OLMo-3-32B
# NDIF build/revision identifier, if exposed (for season reproducibility)
MODEL_BUILD=
LAYER=16
TOKEN_BUDGET=10
SCORING_MODE=cosine_steering_shift
PROBE_SET=data/probes/season1.json
D_FILE=data/directions/d_v1.npz
PREPEND_BOS=true

# ── NDIF call / queue ───────────────────────────────────────
NDIF_TIMEOUT_S=60        # per remote forward pass
SCORE_CONCURRENCY=2      # max concurrent NDIF calls (server-side queue)

# ── Rate limiting / leaderboard (load-bearing: caps NDIF quota) ──
RATE_PER_MIN=30
RATE_PER_DAY=500
GLOBAL_PER_DAY=5000      # hard ceiling on total NDIF scoring calls/day
LEADERBOARD_MAX=200

# ── Server / deploy ─────────────────────────────────────────
PORT=7860
# Lock CORS to the Space's own origin in production, e.g. https://<user>-<space>.hf.space
ALLOWED_ORIGIN=*
